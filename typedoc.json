{
  "out": "docs",
  "highlightLanguages": ["bash", "console", "css", "html", "ini", "javascript", "json", "jsonc", "json5", "tsx", "typescript"],
  "exclude": ["src/**/*.spec.ts"],
  "entryPoints": [
    "src/index.ts"
  ],
  "excludePrivate": true,
  "excludeProtected": true,
  "excludeExternals": true,
  "hideGenerator": true,
  "includeVersion": false,
  "validation": {
    "invalidLink": true,
    "notExported": false
  },
  "inlineTags": ["@link", "@see"]
}
